#include <windows.h>

IDI_APPICON ICON "@SOUNDCHEST_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Benjamin Calderon"
            VALUE "FileDescription", "Sound Chest"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "soundchest"
            VALUE "LegalCopyright", "Copyright (c) 2026 Benjamin Calderon"
            VALUE "OriginalFilename", "soundchest.exe"
            VALUE "ProductName", "Sound Chest"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
