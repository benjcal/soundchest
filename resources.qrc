<RCC>
    <qresource prefix="/icons">
        <file alias="folder-closed.svg">assets/icons/folder-closed.svg</file>
        <file alias="folder-open.svg">assets/icons/folder-open.svg</file>
        <file alias="play.svg">assets/icons/play.svg</file>
        <file alias="repeat.svg">assets/icons/repeat.svg</file>
        <file alias="speaker-high.svg">assets/icons/speaker-high.svg</file>
        <file alias="stop.svg">assets/icons/stop.svg</file>
        <file alias="waveform.svg">assets/icons/waveform.svg</file>
    </qresource>
    <qresource prefix="/themes">
        <file alias="gruvbox.json">assets/themes/gruvbox.json</file>
    </qresource>
</RCC>
